# Logcat-AI environment configuration template
#
# Copy to `.env` at the repo root, then fill in only what you need to override.
# Lines that match their default are commented out — uncomment + edit if you
# want to override. Lines you typically want to set explicitly (provider
# choice, API keys, NODE_ENV) are left active.
#
# All keys here are read by `packages/backend/src/config.ts` (and a few by
# `packages/mcp-server/src/tools.ts`). Frontend has no env vars.

# ────────────────────────────────────────────────────────────────
# Server / runtime
# ────────────────────────────────────────────────────────────────

# Backend HTTP port.
# default: 8000
# PORT=8000

# Where uploaded bugreports are extracted to.
# default: /tmp/logcat-ai-uploads
# UPLOAD_DIR=/tmp/logcat-ai-uploads

# Max upload file size in bytes.
# default: 209715200 (200 MB)
# MAX_FILE_SIZE=209715200

# SQLite DB path used by the backend (analyses + FTS5 indexes).
# default: <repo>/data/logcat-ai.db (resolved at runtime)
# DB_PATH=/var/lib/logcat-ai/logcat-ai.db

# SQLite DB path the MCP server reads to expose history/search tools.
# Set this to the same file `DB_PATH` points to. Without it, the MCP server
# tries a few common locations.
# LOGCAT_AI_DB_PATH=/var/lib/logcat-ai/logcat-ai.db

# Standard Node.js env. `production` disables the dev-only test routes
# under `/api/_test/*` (used by the Playwright FTS5 fallback test).
NODE_ENV=development

# ────────────────────────────────────────────────────────────────
# LLM provider — pick the default the backend uses for Deep Analysis
# and Chat. The Settings UI in the web app can override this at runtime.
# ────────────────────────────────────────────────────────────────

# Which provider Deep Analysis / Chat uses by default.
# Valid: ollama | openai | gemini | anthropic
LLM_PROVIDER=ollama

# ── Ollama (local, free) ──
# default: http://localhost:11434
# OLLAMA_BASE_URL=http://localhost:11434
# default: qwen2.5:72b
# OLLAMA_MODEL=qwen2.5:72b

# ── OpenAI ──
# default: https://api.openai.com
# OPENAI_BASE_URL=https://api.openai.com
# default: gpt-4o
# OPENAI_MODEL=gpt-4o
# Required if LLM_PROVIDER=openai. Leave blank to disable the provider.
OPENAI_API_KEY=

# ── Google Gemini ──
# default: https://generativelanguage.googleapis.com
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# default: gemini-2.0-flash
# GEMINI_MODEL=gemini-2.0-flash
# Required if LLM_PROVIDER=gemini.
GEMINI_API_KEY=

# ── Anthropic Claude ──
# default: https://api.anthropic.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# default: claude-sonnet-4-5-20250929
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Required if LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
