---
config:
  theme: dark
  themeVariables:
    primaryColor: '#4f46e5'
    primaryTextColor: '#e2e8f0'
    primaryBorderColor: '#6366f1'
    lineColor: '#94a3b8'
    textColor: '#e2e8f0'
    nodeTextColor: '#e2e8f0'
---
flowchart TB
    subgraph HW["HARDWARE 外部事件"]
        E1["基地台 Paging<br/>(incoming call/data)"]
        E2["RTC Alarm 到期"]
        E3["USB/充電事件"]
        E4["實體按鍵"]
    end

    subgraph IRQ_LAYER["HARDWARE IRQ"]
        I1["Modem IRQ<br/>EM7590 PCIe"]
        I2["RTC IRQ"]
        I3["PMIC IRQ<br/>Charger"]
        I4["GPIO IRQ<br/>Power Button"]
        GIC["GIC<br/>Generic Interrupt Controller"]
    end

    subgraph KERN["KERNEL"]
        K1["CPU 退出 C-state<br/>(s2idle exit)"]
        K2["IRQ Handler 執行"]
        K3["Driver 呼叫<br/>__pm_wakeup_event(ws, timeout)"]
        K4["dpm_resume()<br/>Driver .resume() callbacks"]
        K5["thaw_processes()<br/>解凍 userspace tasks"]
        K6["記錄 last active<br/>Wakeup Source: qrtr_ws"]
    end

    subgraph NATIVE["HAL / NATIVE"]
        N1["SystemSuspend HAL<br/>autosuspend loop 被喚醒"]
        N2["rild<br/>收到 modem response"]
        N3["bluetooth HAL<br/>收到 HCI event"]
    end

    subgraph FRAMEWORK["FRAMEWORK"]
        F1["PowerManagerService<br/>acquire wakelock<br/>→ 增加 suspend blocker ref"]
        F2["AlarmManagerService<br/>觸發 PendingIntent<br/>→ app BroadcastReceiver"]
        F3["DeviceIdleController<br/>Deep Idle 中？"]
        F4["進入 MAINTENANCE"]
        F5["保持 IDLE<br/>app 操作仍受限"]
        F6["處理完成<br/>釋放 wakelock<br/>suspend blocker ref → 0"]
        F7["SystemSuspend HAL<br/>再次觸發 suspend"]
    end

    E1 --> I1
    E2 --> I2
    E3 --> I3
    E4 --> I4
    I1 --> GIC
    I2 --> GIC
    I3 --> GIC
    I4 --> GIC

    GIC -->|"wakeup IRQ"| K1
    K1 --> K2
    K2 --> K3
    K3 --> K4
    K4 --> K5
    K5 --> K6

    K6 --> N1
    K6 -->|"Modem data"| N2
    K6 -->|"BT event"| N3

    N1 --> F1
    N2 --> F1
    F1 --> F2
    F2 --> F3
    F3 -->|"maintenance alarm"| F4
    F3 -->|"非 maintenance"| F5
    F4 --> F6
    F5 --> F6
    F6 --> F7

    style HW fill:#1a1a2e,stroke:#6366f1,stroke-width:2px
    style IRQ_LAYER fill:#172554,stroke:#ef4444,stroke-width:2px
    style KERN fill:#0f172a,stroke:#3b82f6,stroke-width:2px
    style NATIVE fill:#1e1b4b,stroke:#818cf8,stroke-width:2px
    style FRAMEWORK fill:#1e293b,stroke:#8b5cf6,stroke-width:2px
    style GIC fill:#7c2d12,stroke:#f97316,stroke-width:2px,color:#e2e8f0
